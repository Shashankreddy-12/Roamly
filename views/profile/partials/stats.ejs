<div class="row text-center g-4 mb-5">

    <div class="col-lg-3 col-md-6">

        <div class="card shadow-sm border-0 stat-card">

            <div class="card-body">

                <i class="fa-solid fa-house fs-3 text-danger mb-3"></i>

                <h3><%= stats.listings %></h3>

                <p class="text-muted mb-0">Listings</p>

            </div>

        </div>

    </div>

    <div class="col-lg-3 col-md-6">

        <div class="card shadow-sm border-0 stat-card">

            <div class="card-body">

                <i class="fa-solid fa-calendar-check fs-3 text-danger mb-3"></i>

                <h3><%= stats.bookings %></h3>

                <p class="text-muted mb-0">Bookings</p>

            </div>

        </div>

    </div>

    <div class="col-lg-3 col-md-6">

        <div class="card shadow-sm border-0 stat-card">

            <div class="card-body">

                <i class="fa-solid fa-heart fs-3 text-danger mb-3"></i>

                <h3><%= stats.wishlist %></h3>

                <p class="text-muted mb-0">Wishlist</p>

            </div>

        </div>

    </div>

    <div class="col-lg-3 col-md-6">

        <div class="card shadow-sm border-0 stat-card">

            <div class="card-body">

                <i class="fa-solid fa-star fs-3 text-danger mb-3"></i>

                <h3><%= stats.reviews %></h3>

                <p class="text-muted mb-0">Reviews</p>

            </div>

        </div>

    </div>

</div>