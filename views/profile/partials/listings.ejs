<div class="section mb-5">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h3>🏡 My Listings</h3>

        <a href="/profile/listings" class="text-decoration-none">
            View All →
        </a>

    </div>

    <% if(listings.length === 0){ %>

        <div class="card border-0 shadow-sm">

            <div class="card-body text-center py-5">

                <i class="fa-solid fa-house fs-1 text-secondary mb-3"></i>

                <h5>You haven't listed any properties yet.</h5>

                <p class="text-muted">
                    Start hosting and welcome your first guest.
                </p>

                <a href="/listings/new"
                   class="btn btn-danger">

                    Host on Airdnd

                </a>

            </div>

        </div>

    <% } else { %>

        <% listings.slice(0,3).forEach(listing=>{ %>

            <div class="card shadow-sm border-0 mb-3">

                <div class="row g-0">

                    <div class="col-md-3">

                        <img
                            src="<%= listing.image.url %>"
                            class="img-fluid rounded-start"
                            style="height:180px; object-fit:cover;"
                        >

                    </div>

                    <div class="col-md-9">

                        <div class="card-body d-flex flex-column h-100">

                            <h4>

                                <%= listing.title %>

                            </h4>

                            <p class="text-muted">

                                📍
                                <%= listing.location %>,
                                <%= listing.country %>

                            </p>

                            <p>

                                <strong>

                                    ₹<%= listing.price.toLocaleString("en-IN") %>

                                </strong>

                                / night

                            </p>

                            <div class="mt-auto">

                                <a
                                    href="/listings/<%= listing._id %>"
                                    class="btn btn-dark me-2">

                                    View

                                </a>

                                <a
                                    href="/listings/<%= listing._id %>/edit"
                                    class="btn btn-outline-dark">

                                    Edit

                                </a>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        <% }) %>

    <% } %>

</div>