<% layout("/layouts/boilerplate") %>

<div class="container py-4 wishlist-page">

    <h2 class="mb-4">
        ❤️ My Wishlist
    </h2>

    <% if(wishlist.length === 0){ %>

        <div class="text-center mt-5">

            <h4 class="fw-bold">Your wishlist is empty.</h4>

            <p class="text-muted mb-4">
                Save your favourite stays to quickly find them later.
            </p>

            <a href="/listings" class="btn btn-danger">
                Explore Listings
            </a>

        </div>

    <% } else { %>

        <% wishlist.forEach(listing => { %>

            <div class="card shadow-sm mb-4 border-0 rounded-4">

                <div class="row g-0">

                    <div class="col-lg-4">

                        <img
                            src="<%= listing.image.url %>"
                            class="img-fluid rounded-start"
                            style="height:240px; width:100%; object-fit:cover;"
                        >

                    </div>

                    <div class="col-lg-8">

                        <div class="card-body">

                            <h4>
                                <%= listing.title %>
                            </h4>

                            <p class="text-muted">

                                📍
                                <%= listing.location %>,
                                <%= listing.country %>

                            </p>

                            <h5 class="fw-bold mb-3">

                                ₹<%= listing.price.toLocaleString("en-IN") %>

                                <small>/ night</small>

                            </h5>

                            <div class="mt-4 d-flex gap-3 flex-wrap">

                                <a
                                    href="/listings/<%= listing._id %>"
                                    class="btn btn-danger"
                                >
                                    View Listing
                                </a>

                                <form
                                    action="/wishlist/<%= listing._id %>?_method=DELETE"
                                    method="POST"
                                >

                                    <button class="btn btn-outline-danger">

                                        Remove

                                    </button>

                                </form>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        <% }) %>

    <% } %>

</div>
