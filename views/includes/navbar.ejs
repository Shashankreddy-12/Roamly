<style>
  .btn-search {
    background-color: #fe424d;
    color: white;
    padding:.55rem 1rem;
    border-radius: 2rem;
  }

  .btn-search:hover {
    background-color: #fe424d;
    color: white;
  }

  .btn-search i {
    display: inline;
  }

  .inp-search {
    border-radius: 2rem;
    padding:0.55rem 1rem;
  }

  .icon {
    margin-left: 1rem;
    color: #fe424d;
  }

  .dropdown-toggle::after {
    margin-left: 0.5rem;
  }

  .dropdown-menu {
    border: none;
    border-radius: 12px;
    margin-top:0.4rem;
  }

  .dropdown-item {
    padding: 0.7rem 1rem;
  }

  .search-form{
    width:100%;
    max-width:480px;
}

.search-form .form-control{
    flex:1;
}

@media (max-width:991px){

    .navbar-collapse{
        padding-top:1rem;
        background:white;
    }

    .navbar-nav{
        gap:.35rem;
    }

    .search-form{
        width:100%;
        max-width:100%;
        margin:1rem 0;
    }

    .search-form .form-control{
        flex:1;
    }

    .dropdown{
        width:100%;
    }

    .dropdown-menu{
        width:100%;
    }

}

/* ---------- Mobile ---------- */

@media (max-width:576px){
    .btn-search{
        padding:.45rem .9rem;
        font-size:.9rem
    }
    .dropdown-menu{
        width:100%;
    }
}

@media (max-width:768px){

    .filters{
        top:72px;
        padding:.6rem;
    }

    .filter{
        margin-right:1.4rem;
    }
}
</style>
<nav class="navbar navbar-expand-lg border-bottom sticky-top">

    <div class="container-fluid">

        <!-- Logo -->

        <a class="navbar-brand icon d-flex align-items-center" href="/listings">

            <i class="fa-solid fa-magnifying-glass-location me-2"></i>

            <b style="color:#fe424d;">airdnd</b>

        </a>

        <!-- Hamburger -->

        <button
            class="navbar-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#mainNavbar"
            aria-controls="mainNavbar"
            aria-expanded="false"
            aria-label="Toggle navigation"
        >

            <span class="navbar-toggler-icon"></span>

        </button>

        <!-- Entire collapsible area -->

        <div class="collapse navbar-collapse" id="mainNavbar">

            <!-- Left -->

            <div class="navbar-nav">

                <a class="nav-link" href="/listings">
                    <b>Explore</b>
                </a>

            </div>

            <!-- Search -->

            <form
                class="search-form d-flex mx-lg-auto my-3 my-lg-0"
                action="/listings"
                method="GET"
                role="search"
            >

                <input
                    class="form-control inp-search"
                    type="search"
                    name="search"
                    value="<%= typeof search !== 'undefined' ? search : '' %>"
                    placeholder="Search"
                >

                <button class="btn btn-search ms-2">

                    <i class="fa-solid fa-magnifying-glass"></i>

                    Search

                </button>

            </form>

            <!-- Right -->

            <div class="navbar-nav ms-lg-auto align-items-lg-center">

                <a class="nav-link" href="/listings/new">

                    <b>Host on Airdnd</b>

                </a>

                <% if(!loggeduser){ %>

                    <a class="nav-link" href="/signup">

                        <b>Sign Up</b>

                    </a>

                    <a class="nav-link" href="/login">

                        <b>Login</b>

                    </a>

                <% } else { %>

                    <div class="dropdown">

                        <a
                            class="nav-link dropdown-toggle d-flex align-items-center"
                            href="#"
                            role="button"
                            data-bs-toggle="dropdown"
                        >
                            <i class="fa-solid fa-circle-user me-2"></i>
                            <b><%= loggeduser.username %></b>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow">
                            <li>
                                <a class="dropdown-item" href="/profile">
                                    <i class="fa-solid fa-user me-2"></i>
                                    My Profile
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item text-danger" href="/logout">
                                   <i class="fa-solid fa-right-from-bracket me-2"></i>
                                    Logout
                                </a>
                            </li>
                        </ul>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</nav>


